# Contact form delivery (app/api/contact/route.ts).
#
# Without RESEND_API_KEY the route returns 503 and the form shows the direct
# email address instead of pretending the message was sent. Copy this file to
# .env.local and fill it in to enable delivery.

# From resend.com — the free tier covers this volume.
RESEND_API_KEY=

# Where enquiries land. Optional; defaults to sekai.kanamori@npanalytica.com.
CONTACT_TO=

# Sender address. Optional; defaults to Resend's shared onboarding@resend.dev,
# which works without domain verification but is more likely to be filtered.
# Swap for an address on npanalytica.com once the domain is verified.
CONTACT_FROM=
